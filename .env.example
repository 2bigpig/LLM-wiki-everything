# 复制为 .env 后按需填写。不要提交包含真实密钥的 .env。
POSTGRES_PASSWORD=wiki-local-change-me
# 后端在 Windows 本地运行，连接 Docker 暴露的回环端口。
DATABASE_URL=postgresql+psycopg://wiki:wiki-local-change-me@127.0.0.1:5432/wiki
DATA_DIR=data
# 本地日志按进程写入 api.log / worker.log；DEBUG 可增加排错信息。
LOG_DIR=data/logs
LOG_LEVEL=INFO
API_TOKEN=

# 支持 OpenAI 兼容的 Chat Completions + JSON 输出接口。
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
LLM_MAX_OUTPUT_TOKENS=2400
# 额度单位是 Token，不等同于人民币；未知请求保守计入预留。
MONTHLY_TOKEN_LIMIT=1000000
MAX_CALLS_PER_RUN=20

MAX_UPLOAD_MB=500
MAX_MEDIA_MINUTES=180
MAX_VIDEO_FRAMES=8

# Docker 只暴露回环端口；DATA_DIR 同时只读挂载给 OCR/ASR。
OCR_URL=http://127.0.0.1:8101
ASR_URL=http://127.0.0.1:8102
ASR_MODEL=medium
ASR_COMPUTE_TYPE=int8_float16
INFERENCE_DEVICE=cuda

# BGE-M3 在独立 CPU 容器运行，本地后端只需要 HTTP 客户端。
EMBEDDINGS_ENABLED=true
EMBEDDING_URL=http://127.0.0.1:8103
EMBEDDING_MODEL=BAAI/bge-m3

# 动态网页回退需要同时安装浏览器扩展与 Chromium。
BROWSER_ENABLED=false
